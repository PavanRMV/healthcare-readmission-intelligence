table 'Source Snapshot'
	lineageTag: 7235eeae-6feb-4547-acb8-60f8c719ae7a

	column dataset
		dataType: string
		lineageTag: d9ddcaa4-37bb-466d-91fd-313123d9c2a3
		summarizeBy: none
