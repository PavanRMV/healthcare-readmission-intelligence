		summarizeBy: none
		sourceColumn: sha256

		annotation SummarizationSetBy = Automatic

	partition 'Source Snapshot Import' = m
		mode: import
		source =
				let
				    CsvPath = ProjectRoot & "\\outputs\\source_snapshot.csv",
				    Source = Csv.Document(File.Contents(CsvPath),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Renamed = Table.RenameColumns(Promoted,{{"source_name", "dataset"}, {"retrieved_at_utc", "retrieved_at"}, {"rows", "row_count"}}),
				    Typed = Table.TransformColumnTypes(Renamed,{{"dataset", type text}, {"source_url", type text}, {"retrieved_at", type text}, {"row_count", Int64.Type}, {"sha256", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
